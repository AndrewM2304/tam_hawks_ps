extends RefCounted
## C04-L03: Civic west bank -> lower-court Ollie/Manual -> gallery close ->
## gallery entrance bank. Only the initial supported spawn/facing are fixtures.
## Every later metre and heading change is generated by production inputs.

const Density = preload("res://tests/full_level_density_tests.gd")
const Routes = preload("res://tests/world_routes_tests.gd")
const POINTS := [Vector3(-22,6,-114),Vector3(-22,6,-108),Vector3(-22,4,-96),
	Vector3(-22,4,-72),Vector3(-18,4,-65),Vector3(-12,4,-59),Vector3(-12,4,-56),
	Vector3(-12,2,-42),Vector3(-12,2,-40),Vector3(-10,2,-37),
	Vector3(-6.75,2.65,-37),Vector3(-3,2.65,-37)]
const MANUAL_TARGETS := [Vector3(-22,4,-72),Vector3(-18,4,-65),Vector3(-12,4,-59),
	Vector3(-12,2,-43),Vector3(-12,2,-40),Vector3(-10,2,-37),Vector3(-3,2.65,-37)]


static func run(tree: SceneTree,game: Node,check: Callable,observer: Callable=Callable()) -> void:
	await _construction(tree,game,check)
	await run_player(tree,game,check,observer)
	await _transit(tree,game,check)


static func _construction(tree: SceneTree,game: Node,check: Callable) -> void:
	await _frames(tree,2)
	var world: Node3D=game.world
	var support := true
	var clear := true
	var samples := 0
	for index: int in POINTS.size()-1:
		var first: Vector3=POINTS[index]
		var last: Vector3=POINTS[index+1]
		var tangent: Vector3=(last-first).normalized()
		var side:=Vector3(tangent.z,0,-tangent.x).normalized()*0.6
		clear=clear and Routes._clear_sweep(world,first,last) and Routes._clear_sweep(world,last,first)
		for step: int in 9:
			for lateral: float in [-1.0,0.0,1.0]:
				var point:=first.lerp(last,float(step)/8.0)+side*lateral
				# Lateral samples across a bank inherit its actual plane height.
				var height: float=world.get_ground_height(point)
				var hit:=world.get_world_3d().direct_space_state.intersect_ray(
					PhysicsRayQueryParameters3D.create(Vector3(point.x,height+0.12,point.z),
					Vector3(point.x,height-0.12,point.z),1))
				support=support and is_finite(height) and absf(height-point.y)<0.16 \
					and not hit.is_empty() and absf(hit.position.y-height)<0.002
				samples+=1
	check.call(support and clear,"C04-L03:297 fixed-width bank/court/close/entrance sites have native support and two-way rider clearance")
	var lower_return := true
	for pair: Array in [[Vector3(-78,1,-66),Vector3(-78,4,-74)],
		[Vector3(-59,1,-54),Vector3(-59,2,-42)],
		[Vector3(-22,4,-74),Vector3(22,4,-74)]]:
		lower_return=lower_return and Routes._clear_sweep(world,pair[0],pair[1]) \
			and Routes._clear_sweep(world,pair[1],pair[0])
	check.call(lower_return,"C04-L03: both actual Merchant lower-court escapes and the civic cross-street remain clear")
	print("CIVIC_FLAGSHIP_GEOMETRY samples=",samples," support=",support," clear=",clear,
		" lower_return=",lower_return," added_bodies=0 added_triangles=0 added_draws=0")


static func run_player(tree: SceneTree,game: Node,check: Callable,observer: Callable=Callable()) -> void:
	var old_spawn: Vector3=game.skater.spawn_position
	var old_free: bool=game.free_skate_mode
	_release()
	game.skater.spawn_position=POINTS[0]+Vector3.UP*0.08
	game.start_mode(true)
	game.skater.rotation.y=PI
	await _frames(tree,12)
	var evidence := {"ticks":0,"bails":0,"banks":0,"score":0,"phase":"",
		"manual_ticks":0,"manual_begin":Vector3.INF,"manual_end":Vector3.INF,
		"bank_slope_ticks":0,"close_slope_ticks":0,"entrance_slope_ticks":0,
		"camera_samples":0,"camera_clear":true,"tricks":[],"stages":[],
		"distance":0.0,"previous":game.skater.global_position}
	var on_bail:=func()->void:evidence.bails+=1
	var on_trick:=func(title: String,_points: int)->void:evidence.tricks.append(title)
	game.skater.bailed.connect(on_bail)
	game.skater.trick_performed.connect(on_trick)
	var descended := false
	for frame: int in 360:
		_speed(game,10.5)
		_aim(game,Vector3(-22,4,-94))
		await _step(tree,game,evidence,"civic_bank_descent",observer)
		if game.skater.global_position.z>= -95.0:
			descended=true
			break
		if evidence.bails>0:break
	var landed := false
	if descended and evidence.bails==0:
		Input.action_press("ollie")
		await _step(tree,game,evidence,"lower_court_pop",observer)
		await _step(tree,game,evidence,"lower_court_pop",observer)
		Input.action_release("ollie")
		for frame: int in 120:
			await _step(tree,game,evidence,"lower_court_air",observer)
			if frame>4 and game.skater.is_on_floor() and not game.skater.airborne:
				landed=true
				Input.action_press("manual")
				break
			if evidence.bails>0:break
	var target_index := 0
	var manual := false
	var pending := 0
	if landed:
		for frame: int in 1200:
			var at: Vector3=game.skater.global_position
			var target: Vector3=MANUAL_TARGETS[target_index]
			if Vector2(at.x-target.x,at.z-target.z).length()<1.05:
				target_index+=1
				if target_index==MANUAL_TARGETS.size():
					evidence.manual_end=at
					pending=game.score.get_combo_value()
					break
				target=MANUAL_TARGETS[target_index]
			_aim(game,target)
			if game.skater.manual_active:
				manual=true
				_balance(game.skater)
			else:
				_axis("steer_left","steer_right",0.0)
			await _step(tree,game,evidence,"manual_court_close_entrance",observer)
			if evidence.bails>0 or evidence.banks>0:break
	var reached: bool=target_index==MANUAL_TARGETS.size() and game.skater.global_position.y>2.55
	Input.action_release("manual")
	_axis("steer_left","steer_right",0.0)
	_axis("spin_left","spin_right",0.0)
	# Keep Up held while braking so the observation cannot manufacture an
	# Up-neutral-Down nose-manual gesture and accidentally extend the combo.
	Input.action_press("push",1.0)
	Input.action_press("brake",1.0)
	for frame: int in 60:await _step(tree,game,evidence,"single_bank_on_entrance",observer)
	_release()
	for frame: int in 24:await _step(tree,game,evidence,"stable_bank_observation",observer)
	var total: int=game.score.total_score
	check.call(descended and evidence.bank_slope_ticks>=12 and landed and evidence.tricks.has("Ollie"),
		"C04-L03: actual Push descends the civic bank and earns a lower-court Ollie before landing")
	check.call(manual and reached and evidence.manual_ticks>=180 and evidence.manual_begin.is_finite()
		and evidence.manual_end.is_finite() and evidence.manual_end.distance_to(evidence.manual_begin)>45.0 \
		and evidence.close_slope_ticks>=12 and evidence.entrance_slope_ticks>=4,
		"C04-L03: actual balanced Manual carves through the lower civic court and graded close onto the raised gallery entrance")
	check.call(evidence.bails==0 and evidence.banks==1 and pending>200 and total==pending
		and game.score.last_banked==pending and game.score.get_combo_value()==0,
		"C04-L03: the complete civic/gallery Ollie-Manual route banks its exact earned value once")
	check.call(evidence.camera_samples>=60 and evidence.camera_clear,
		"C04-L03: complete rider, board, soles and native chase volume stay clear along the full linked run")
	print("CIVIC_FLAGSHIP_RESULT ",JSON.stringify({"descended":descended,"landed":landed,
		"manual":manual,"reached":reached,"target_index":target_index,"pending":pending,
		"banked":total,"bails":evidence.bails,"banks":evidence.banks,"ticks":evidence.ticks,
		"manual_ticks":evidence.manual_ticks,"manual_begin":var_to_str(evidence.manual_begin),
		"manual_end":var_to_str(evidence.manual_end),"distance":evidence.distance,
		"bank_slope_ticks":evidence.bank_slope_ticks,"close_slope_ticks":evidence.close_slope_ticks,
		"entrance_slope_ticks":evidence.entrance_slope_ticks,"camera_clear":evidence.camera_clear,
		"camera_samples":evidence.camera_samples,"tricks":evidence.tricks,"stages":evidence.stages,
		"at":var_to_str(game.skater.global_position)}))
	game.skater.bailed.disconnect(on_bail)
	game.skater.trick_performed.disconnect(on_trick)
	game.skater.spawn_position=old_spawn
	game.start_mode(old_free)


static func _transit(tree: SceneTree,game: Node,check: Callable) -> void:
	var old_spawn: Vector3=game.skater.spawn_position
	var old_free: bool=game.free_skate_mode
	for reverse: bool in [false,true]:
		var targets: Array=POINTS.duplicate()
		if reverse:targets.reverse()
		_release()
		game.skater.spawn_position=targets[0]+Vector3.UP*0.08
		game.start_mode(true)
		var first: Vector3=targets[1]-targets[0]
		game.skater.rotation.y=atan2(-first.x,-first.z)
		await _frames(tree,12)
		var bails := [0]
		var on_bail:=func()->void:bails[0]+=1
		game.skater.bailed.connect(on_bail)
		var next := 1
		var grounded := true
		for frame: int in 1440:
			var at: Vector3=game.skater.global_position
			var target: Vector3=targets[next]
			if Vector2(at.x-target.x,at.z-target.z).length()<1.0:
				next+=1
				if next==targets.size():break
				target=targets[next]
			_speed(game,6.5)
			_aim(game,target)
			await _frames(tree,1)
			grounded=grounded and not game.skater.airborne
			if bails[0]>0:break
		_release()
		check.call(next==targets.size() and grounded and bails[0]==0,
			"C04-L03: ordinary no-jump "+("gallery-to-civic return" if reverse else "civic-to-gallery bypass")+" follows the entire supported line")
		print("CIVIC_FLAGSHIP_TRANSIT reverse=",reverse," reached=",next==targets.size(),
			" target=",next," grounded=",grounded," bails=",bails[0]," at=",game.skater.global_position)
		game.skater.bailed.disconnect(on_bail)
	game.skater.spawn_position=old_spawn
	game.start_mode(old_free)


static func _aim(game: Node,target: Vector3) -> void:
	var offset: Vector3=target-game.skater.global_position
	var desired:=atan2(-offset.x,-offset.z)
	var error:=angle_difference(game.skater.rotation.y,desired)
	if game.skater.manual_active:
		_axis("spin_left","spin_right",-clampf(error*3.2,-1.0,1.0))
	else:
		_axis("spin_left","spin_right",0.0)
		_axis("steer_left","steer_right",-clampf(error*3.2,-1.0,1.0))


static func _balance(skater: Node) -> void:
	var age: float=skater.get("_manual_elapsed")
	var value: float=skater.manual_balance
	_axis("steer_left","steer_right",clampf(-(.18+.08*age)/1.5-(value-.05)*1.2,-.9,.9))


static func _speed(game: Node,ceiling: float) -> void:
	Input.action_press("push",0.7)
	Input.action_release("brake")
	if game.skater.speed>ceiling:Input.action_press("brake",0.5)


static func _step(tree: SceneTree,game: Node,evidence: Dictionary,stage: String,observer: Callable) -> void:
	await _frames(tree,1)
	evidence.ticks+=1
	var at: Vector3=game.skater.global_position
	evidence.distance+=at.distance_to(evidence.previous)
	evidence.previous=at
	if stage!=evidence.phase:
		evidence.phase=stage
		evidence.stages.append({"stage":stage,"at":var_to_str(at),"speed":game.skater.speed})
	if game.skater.manual_active:
		evidence.manual_ticks+=1
		if not evidence.manual_begin.is_finite():evidence.manual_begin=at
	if game.skater.is_on_floor() and game.skater.get_floor_normal().y<0.999:
		if at.z < -96:evidence.bank_slope_ticks+=1
		elif at.z < -42 and absf(at.x+12)<2:evidence.close_slope_ticks+=1
		elif at.x > -10.1 and at.x < -6.7 and at.z > -40:evidence.entrance_slope_ticks+=1
	if game.score.total_score!=evidence.score:
		evidence.banks+=1
		evidence.score=game.score.total_score
	if evidence.ticks%6==0:
		evidence.camera_samples+=1
		evidence.camera_clear=Density._camera_clear(game) and evidence.camera_clear
	if observer.is_valid():await observer.call(stage,game,evidence.ticks)


static func _axis(left: String,right: String,value: float) -> void:
	Input.action_release(left)
	Input.action_release(right)
	if value<0:Input.action_press(left,-value)
	elif value>0:Input.action_press(right,value)


static func _frames(tree: SceneTree,count: int) -> void:
	for frame: int in count:
		await tree.physics_frame
		await tree.create_timer(0.0,false,false).timeout


static func _release() -> void:
	for action: String in ["push","brake","manual","ollie","grind","steer_left","steer_right","spin_left","spin_right"]:
		Input.action_release(action)
