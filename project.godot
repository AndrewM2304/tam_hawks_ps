; Godot 4.6.3 — original arcade skating prototype.
config_version=5

[application]
config/name="Tam Hawks Pro Skater"
run/main_scene="res://game/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/description="Four districts. Two minutes. Find your line through Glasgow."
config/icon="res://game/icon.svg"

[display]
window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=800
window/stretch/mode="canvas_items"

[rendering]
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=1
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.55, 0.66, 0.69, 1)

[physics]
common/physics_ticks_per_second=60
3d/default_gravity=24.0
