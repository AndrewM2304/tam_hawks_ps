+func _manual_probe_rest(pose:Transform3D,wheel_index:int,overlaps:Array,probe:Dictionary) -> Dictionary:
+	# The caller just restored this exact drawn frame. Reuse only the original
+	# loaded-wheel ray from THIS physics callback, never a nearby/stored plane.
+	if (not manual_active or airborne or not _native_floor_valid or not is_on_floor()
+			or overlaps.size()!=1 or not probe.has_all(["physics","frame","wheels","hits"])
+			or typeof(probe.physics)!=TYPE_INT or int(probe.physics)!=Engine.get_physics_frames()
+			or typeof(probe.frame)!=TYPE_TRANSFORM3D or not probe.wheels is Array
+			or not probe.hits is Array or probe.wheels.size()!=2 or probe.hits.size()!=2
+			or wheel_index<0 or wheel_index>=_floor_wheel_shapes.size()):return {}
+	var previous:Transform3D=probe.frame
+	if (not pose.is_finite() or not previous.is_finite()
+			or pose.origin.distance_to(previous.origin)>0.00001
+			or pose.basis.x.distance_to(previous.basis.x)>0.000001
+			or pose.basis.y.distance_to(previous.basis.y)>0.000001
+			or pose.basis.z.distance_to(previous.basis.z)>0.000001):return {}
+	if (typeof(probe.wheels[0])!=TYPE_INT or typeof(probe.wheels[1])!=TYPE_INT
+			or probe.wheels[0]==probe.wheels[1]):return {}
+	var slot:int=probe.wheels.find(wheel_index)
+	if slot<0 or not probe.hits[slot] is Dictionary or not overlaps[0] is Dictionary:return {}
+	var ray:Dictionary=probe.hits[slot]
+	var overlap:Dictionary=overlaps[0]
+	if (not ray.has_all(["position","normal","rid","shape","collider"])
+			or not overlap.has_all(["rid","shape","collider"])
+			or typeof(ray.position)!=TYPE_VECTOR3 or typeof(ray.normal)!=TYPE_VECTOR3
+			or typeof(ray.rid)!=TYPE_RID or typeof(overlap.rid)!=TYPE_RID
+			or typeof(ray.shape)!=TYPE_INT or typeof(overlap.shape)!=TYPE_INT
+			or ray.rid!=overlap.rid or ray.shape!=overlap.shape or ray.collider!=overlap.collider):return {}
+	var raw:Variant=ray.collider
+	if typeof(raw)!=TYPE_OBJECT or not is_instance_valid(raw):return {}
+	var body:=raw as PhysicsBody3D
+	if (body==null or not body.is_inside_tree() or body.get_rid()!=ray.rid
+			or body.get_rid()==get_rid() or int(ray.shape)<0
+			or int(ray.shape)>=PhysicsServer3D.body_get_shape_count(body.get_rid())):return {}
+	var normal:Vector3=ray.normal
+	var point:Vector3=ray.position
+	if (not normal.is_finite() or not point.is_finite()
+			or not is_finite(normal.length_squared()) or absf(normal.length_squared()-1.0)>0.00001
+			or normal.y<cos(floor_max_angle)):return {}
+	var wheels:Array=_visual_rig.board_contact_geometry().wheels
+	if wheels.size()!=_floor_wheel_shapes.size() or wheels.size()!=4:return {}
+	if Vector3(wheels[wheel_index].center).z*_board_visual.rotation.x<=0.0:return {}
+	var bearing:Vector3=pose*Vector3(wheels[wheel_index].center)
+	var delta:Vector3=point-bearing
+	# These are the original finite0.35m-up/0.50m-down vertical ray endpoints.
+	# Agreement is an arithmetic/authentication guard, not penetration leeway.
+	if (not bearing.is_finite() or not delta.is_finite() or absf(delta.x)>0.00001
+			or absf(delta.z)>0.00001 or delta.y>0.35001 or delta.y< -0.50001):return {}
+	return ray
 
 
