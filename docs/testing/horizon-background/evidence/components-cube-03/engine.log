148: // This is an approximation and simplification of EaryChow's AgX implementation that is used by Blender.
149: // This code is based off of the script that generates the AgX_Base_sRGB.cube LUT that Blender uses.
150: // Source: https://github.com/EaryChow/AgX_LUT_Gen/blob/main/AgXBasesRGB.py
151: // Colorspace transformation source: https://www.colour-science.org:8010/apps/rgb_colourspace_transformation_matrix
152: vec3 tonemap_agx(vec3 color) {
153: 	// Input color should be non-negative!
154: 	// Large negative values in one channel and large positive values in other
155: 	// channels can result in a colour that appears darker and more saturated than
156: 	// desired after passing it through the inset matrix. For this reason, it is
157: 	// best to prevent negative input values.
158: 	// This is done before the Rec. 2020 transform to allow the Rec. 2020
159: 	// transform to be combined with the AgX inset matrix. This results in a loss
160: 	// of color information that could be correctly interpreted within the
161: 	// Rec. 2020 color space as positive RGB values, but is often not worth
162: 	// the performance cost of an additional matrix multiplication.
163: 	//
164: 	// Additionally, this AgX configuration was created subjectively based on
165: 	// output appearance in the Rec. 709 color gamut, so it is possible that these
166: 	// matrices will not perform well with non-Rec. 709 output (more testing with
167: 	// future wide-gamut displays is be needed).
168: 	// See this comment from the author on the decisions made to create the matrices:
169: 	// https://github.com/godotengine/godot-proposals/issues/12317#issuecomment-2835824250
170: 
171: 	// Combined Rec. 709 to Rec. 2020 and Blender AgX inset matrices:
172: 	const mat3 rec709_to_rec2020_agx_inset_matrix = mat3(
173: 			0.544814746488245, 0.140416948464053, 0.0888104196149096,
174: 			0.373787398372697, 0.754137554567394, 0.178871756420858,
175: 			0.0813978551390581, 0.105445496968552, 0.732317823964232);
176: 
177: 	// Combined inverse AgX outset matrix and Rec. 2020 to Rec. 709 matrices.
178: 	const mat3 agx_outset_rec2020_to_rec709_matrix = mat3(
179: 			1.96488741169489, -0.299313364904742, -0.164352742528393,
180: 			-0.855988495690215, 1.32639796461980, -0.238183969428088,
181: 			-0.108898916004672, -0.0270845997150571, 1.40253671195648);
182: 
183: 	const float output_max_value = 1.0; // SDR always has an output_max_value of 1.0
184: 
185: 	// Apply inset matrix.
186: 	color = rec709_to_rec2020_agx_inset_matrix * color;
187: 
188: 	// Use the allenwp tonemapping curve to match the Blender AgX curve while
189: 	// providing stability across all variable dyanimc range (SDR, HDR, EDR).
190: 	color = allenwp_curve(color);
191: 
192: 	// Clipping to output_max_value is required to address a cyan colour that occurs
193: 	// with very bright inputs.
194: 	color = min(vec3(output_max_value), color);
195: 
196: 	// Apply outset to make the result more chroma-laden and then go back to Rec. 709.
197: 	color = agx_outset_rec2020_to_rec709_matrix * color;
198: 
199: 	// Blender's lusRGB.compensate_low_side is too complex for this shader, so
200: 	// simply return the color, even if it has negative components. These negative
201: 	// components may be useful for subsequent color adjustments.
202: 	return color;
203: }
