205: #define TONEMAPPER_LINEAR 0
206: #define TONEMAPPER_REINHARD 1
207: #define TONEMAPPER_FILMIC 2
208: #define TONEMAPPER_ACES 3
209: #define TONEMAPPER_AGX 4
210: 
211: vec3 apply_tonemapping(vec3 color) { // inputs are LINEAR
212: 	if (tonemapper == TONEMAPPER_LINEAR) {
213: 		return color;
214: 	}
215: 
216: 	// Ensure color values passed to tonemappers are positive.
217: 	// They can be negative in the case of negative lights, which leads to undesired behavior.
218: 	color = max(vec3(0.0), color);
219: 
220: 	if (tonemapper == TONEMAPPER_REINHARD) {
221: 		return tonemap_reinhard(color);
222: 	} else if (tonemapper == TONEMAPPER_FILMIC) {
223: 		return tonemap_filmic(color);
224: 	} else if (tonemapper == TONEMAPPER_ACES) {
225: 		return tonemap_aces(color);
226: 	} else { // TONEMAPPER_AGX
227: 		return tonemap_agx(color);
228: 	}
229: }
230: 
231: #endif // APPLY_TONEMAPPING
