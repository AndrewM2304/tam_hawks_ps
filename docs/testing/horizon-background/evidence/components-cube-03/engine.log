62: // Based on Reinhard's extended formula, see equation 4 in https://doi.org/cjbgrt
63: vec3 tonemap_reinhard(vec3 color) {
64: 	float white_squared = tonemapper_params.x;
65: 	vec3 white_squared_color = white_squared * color;
66: 	// Equivalent to color * (1 + color / white_squared) / (1 + color)
67: 	return (white_squared_color + color * color) / (white_squared_color + white_squared);
68: }
69: 
70: vec3 tonemap_filmic(vec3 color) {
71: 	// These constants must match the those in the C++ code that calculates the parameters.
72: 	// exposure_bias: Input scale (color *= bias, env->white *= bias) to make the brightness consistent with other tonemappers.
73: 	// Also useful to scale the input to the range that the tonemapper is designed for (some require very high input values).
74: 	// Has no effect on the curve's general shape or visual properties.
75: 	const float exposure_bias = 2.0f;
76: 	const float A = 0.22f * exposure_bias * exposure_bias; // bias baked into constants for performance
77: 	const float B = 0.30f * exposure_bias;
78: 	const float C = 0.10f;
79: 	const float D = 0.20f;
80: 	const float E = 0.01f;
81: 	const float F = 0.30f;
82: 
83: 	vec3 color_tonemapped = ((color * (A * color + C * B) + D * E) / (color * (A * color + B) + D * F)) - E / F;
84: 
85: 	return color_tonemapped / tonemapper_params.x;
86: }
87: 
88: // Adapted from https://github.com/TheRealMJP/BakingLab/blob/master/BakingLab/ACES.hlsl
89: // (MIT License).
90: vec3 tonemap_aces(vec3 color) {
91: 	// These constants must match the those in the C++ code that calculates the parameters.
92: 	const float exposure_bias = 1.8f;
93: 	const float A = 0.0245786f;
94: 	const float B = 0.000090537f;
95: 	const float C = 0.983729f;
96: 	const float D = 0.432951f;
97: 	const float E = 0.238081f;
98: 
99: 	// Exposure bias baked into transform to save shader instructions. Equivalent to `color *= exposure_bias`
100: 	const mat3 rgb_to_rrt = mat3(
101: 			vec3(0.59719f * exposure_bias, 0.35458f * exposure_bias, 0.04823f * exposure_bias),
102: 			vec3(0.07600f * exposure_bias, 0.90834f * exposure_bias, 0.01566f * exposure_bias),
103: 			vec3(0.02840f * exposure_bias, 0.13383f * exposure_bias, 0.83777f * exposure_bias));
104: 
105: 	const mat3 odt_to_rgb = mat3(
106: 			vec3(1.60475f, -0.53108f, -0.07367f),
107: 			vec3(-0.10208f, 1.10813f, -0.00605f),
108: 			vec3(-0.00327f, -0.07276f, 1.07602f));
109: 
110: 	color *= rgb_to_rrt;
111: 	vec3 color_tonemapped = (color * (color + A) - B) / (color * (C * color + D) + E);
112: 	color_tonemapped *= odt_to_rgb;
113: 
114: 	return color_tonemapped / tonemapper_params.x;
115: }
