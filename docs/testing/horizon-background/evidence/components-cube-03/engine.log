117: // allenwp tonemapping curve; developed for use in the Godot game engine.
118: // Source and details: https://allenwp.com/blog/2025/05/29/allenwp-tonemapping-curve/
119: // Input must be a non-negative linear scene value.
120: vec3 allenwp_curve(vec3 x) {
121: 	const float output_max_value = 1.0; // SDR always has an output_max_value of 1.0
122: 
123: 	// These constants must match the those in the C++ code that calculates the parameters.
124: 	// 18% "middle gray" is perceptually 50% of the brightness of reference white.
125: 	const float awp_crossover_point = 0.18;
126: 	// When output_max_value and/or awp_crossover_point are no longer constant,
127: 	// awp_shoulder_max can be calculated on the CPU and passed in as tonemap_e.
128: 	const float awp_shoulder_max = output_max_value - awp_crossover_point;
129: 
130: 	float awp_contrast = tonemapper_params.x;
131: 	float awp_toe_a = tonemapper_params.y;
132: 	float awp_slope = tonemapper_params.z;
133: 	float awp_w = tonemapper_params.w;
134: 
135: 	// Reinhard-like shoulder:
136: 	vec3 s = x - awp_crossover_point;
137: 	vec3 slope_s = awp_slope * s;
138: 	s = slope_s * (1.0 + s / awp_w) / (1.0 + (slope_s / awp_shoulder_max));
139: 	s += awp_crossover_point;
140: 
141: 	// Sigmoid power function toe:
142: 	vec3 t = pow(x, vec3(awp_contrast));
143: 	t = t / (t + awp_toe_a);
144: 
145: 	return mix(s, t, lessThan(x, vec3(awp_crossover_point)));
