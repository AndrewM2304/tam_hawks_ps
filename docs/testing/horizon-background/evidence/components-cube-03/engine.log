205: #define TONEMAPPER_LINEAR 0
206: #define TONEMAPPER_REINHARD 1
207: #define TONEMAPPER_FILMIC 2
208: #define TONEMAPPER_ACES 3
209: #define TONEMAPPER_AGX 4
