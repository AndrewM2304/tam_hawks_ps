335: vec4 fog_process(vec3 view, vec3 sky_color) {
336: 	vec3 fog_color = mix(fog_light_color.rgb, sky_color, fog_aerial_perspective);
337: 
338: 	if (fog_sun_scatter > 0.001) {
339: 		vec4 sun_scatter = vec4(0.0);
340: 		float sun_total = 0.0;
341: 		for (uint i = 0u; i < directional_light_count; i++) {
342: 			vec3 light_color = srgb_to_linear(directional_lights.data[i].color_size.xyz) * directional_lights.data[i].direction_energy.w;
343: 			float light_amount = pow(max(dot(view, directional_lights.data[i].direction_energy.xyz), 0.0), 8.0) * M_PI;
344: 			fog_color += light_color * light_amount * fog_sun_scatter;
345: 		}
346: 	}
