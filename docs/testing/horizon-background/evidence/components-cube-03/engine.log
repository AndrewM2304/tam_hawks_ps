352: // Eberly approximations from https://seblagarde.wordpress.com/2014/12/01/inverse-trigonometric-functions-gpu-optimization-for-amd-gcn-architecture/.
353: // input [-1, 1] and output [0, PI]
354: float acos_approx(float p_x) {
355: 	float x = abs(p_x);
356: 	float res = -0.156583f * x + (M_PI / 2.0);
357: 	res *= sqrt(1.0f - x);
358: 	return (p_x >= 0.0) ? res : M_PI - res;
359: }
360: 
361: // Based on https://math.stackexchange.com/questions/1098487/atan2-faster-approximation
362: // but using the Eberly coefficients from https://seblagarde.wordpress.com/2014/12/01/inverse-trigonometric-functions-gpu-optimization-for-amd-gcn-architecture/.
363: float atan2_approx(float y, float x) {
364: 	float a = min(abs(x), abs(y)) / max(abs(x), abs(y));
365: 	float s = a * a;
366: 	float poly = 0.0872929f;
367: 	poly = -0.301895f + poly * s;
368: 	poly = 1.0f + poly * s;
369: 	poly = poly * a;
370: 
371: 	float r = abs(y) > abs(x) ? (M_PI / 2.0) - poly : poly;
372: 	r = x < 0.0 ? M_PI - r : r;
373: 	r = y < 0.0 ? -r : r;
374: 
375: 	return r;
376: }
