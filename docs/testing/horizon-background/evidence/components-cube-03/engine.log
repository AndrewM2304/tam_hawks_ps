378: void main() {
379: 	vec3 cube_normal;
380: #ifdef USE_MULTIVIEW
381: 	// In multiview our projection matrices will contain positional and rotational offsets that we need to properly unproject.
382: 	vec4 unproject = vec4(uv_interp.xy, -1.0, 1.0); // unproject at the far plane
383: 	vec4 unprojected = multiview_data.inv_projection_matrix_view[ViewIndex] * unproject;
384: 	cube_normal = unprojected.xyz / unprojected.w;
385: 
386: 	// Unproject will give us the position between the eyes, need to re-offset.
387: 	cube_normal += multiview_data.eye_offset[ViewIndex].xyz;
