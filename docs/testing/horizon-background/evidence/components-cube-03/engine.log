54: // This expects 0-1 range input, outside that range it behaves poorly.
55: vec3 srgb_to_linear(vec3 color) {
56: 	// Approximation from http://chilliant.blogspot.com/2012/08/srgb-approximations-for-hlsl.html
57: 	return color * (color * (color * 0.305306011 + 0.682171111) + 0.012522878);
58: }
