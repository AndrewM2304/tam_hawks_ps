378: void main() {
379: 	vec3 cube_normal;
380: #ifdef USE_MULTIVIEW
381: 	// In multiview our projection matrices will contain positional and rotational offsets that we need to properly unproject.
382: 	vec4 unproject = vec4(uv_interp.xy, -1.0, 1.0); // unproject at the far plane
383: 	vec4 unprojected = multiview_data.inv_projection_matrix_view[ViewIndex] * unproject;
384: 	cube_normal = unprojected.xyz / unprojected.w;
385: 
386: 	// Unproject will give us the position between the eyes, need to re-offset.
387: 	cube_normal += multiview_data.eye_offset[ViewIndex].xyz;
388: #else
389: 	cube_normal.z = -1.0;
390: 	cube_normal.x = (uv_interp.x + projection.x) / projection.y;
391: 	cube_normal.y = (-uv_interp.y - projection.z) / projection.w;
392: #endif
393: 	cube_normal = mat3(orientation) * cube_normal;
394: 	cube_normal = normalize(cube_normal);
395: 
396: 	vec2 uv = gl_FragCoord.xy; // uv_interp * 0.5 + 0.5;
397: 
398: 	vec2 panorama_coords = vec2(atan2_approx(cube_normal.x, -cube_normal.z), acos_approx(cube_normal.y));
399: 
400: 	if (panorama_coords.x < 0.0) {
401: 		panorama_coords.x += M_PI * 2.0;
402: 	}
403: 
404: 	panorama_coords /= vec2(M_PI * 2.0, M_PI);
405: 
406: 	vec3 color = vec3(0.0, 0.0, 0.0);
407: 	float alpha = 1.0; // Only available to subpasses
408: 	vec4 half_res_color = vec4(1.0);
409: 	vec4 quarter_res_color = vec4(1.0);
410: 	vec4 custom_fog = vec4(0.0);
411: 
