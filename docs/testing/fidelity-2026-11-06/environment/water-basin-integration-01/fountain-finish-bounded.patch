+
+static func _basin_surface_info(mesh: Mesh) -> Dictionary:
+	var arrays:=mesh.surface_get_arrays(0)
+	var positions: PackedVector3Array=arrays[Mesh.ARRAY_VERTEX]
+	var indices: PackedInt32Array=arrays[Mesh.ARRAY_INDEX]
+	var top:=0
+	var floor_count:=0
+	var outer: Dictionary={}
+	var inner: Dictionary={}
+	var annulus_radii_valid:=true
+	for offset: int in range(0,indices.size(),3):
+		# Mesh.get_faces() snaps coordinates; inspect the exact referenced streams.
+		var a:=positions[indices[offset]]
+		var b:=positions[indices[offset+1]]
+		var c:=positions[indices[offset+2]]
+		if absf(a.y-.275)<.00001 and absf(b.y-.275)<.00001 and absf(c.y-.275)<.00001:
+			top+=1
+			for point: Vector3 in [a,b,c]:
+				var radius:=Vector2(point.x,point.z).length()
+				var key:=Vector2i(roundi(point.x*10000.0),roundi(point.z*10000.0))
+				annulus_radii_valid=annulus_radii_valid and radius>=5.9599 and radius<=6.2001
+				if absf(radius-6.2)<.00001:outer[key]=true
+				elif absf(radius-5.96)<.00001:inner[key]=true
+		elif absf(a.y+.225)<.00001 and absf(b.y+.225)<.00001 and absf(c.y+.225)<.00001:floor_count+=1
+	return {"source_triangles":indices.size()/3,"top_triangles":top,"floor_triangles":floor_count,"outer_boundary_vertices":outer.size(),"inner_boundary_vertices":inner.size(),"annulus_radii_valid":annulus_radii_valid}
