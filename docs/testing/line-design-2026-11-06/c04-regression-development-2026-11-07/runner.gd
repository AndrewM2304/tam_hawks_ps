extends SceneTree
const Main=preload("res://game/main.gd")
const Setup=preload("res://game/core/input_setup.gd")
const Driver=preload("res://tests/pt24_flagship_runs_tests.gd")
const Layout=preload("res://tests/pt24_connected_runs_tests.gd")
const Civic=preload("res://tests/pt24_civic_flagship_tests.gd")
const Clyde=preload("res://tests/pt24_clyde_flagship_tests.gd")
const Park=preload("res://tests/pt24_park_run_tests.gd")
const Gallery=preload("res://tests/pt24_gallery_entrance_run_tests.gd")
const Gate=preload("res://tests/pt24_gate_route_tests.gd")
const ParkTransit=preload("res://tests/pt24_park_flagship_tests.gd")
const ParkCombo=preload("res://tests/pt24_park_full_combo_tests.gd")
const Market=preload("res://tests/pt24_market_full_run_tests.gd")
const CivicPark=preload("res://tests/pt24_civic_park_run_tests.gd")
const Facility=preload("res://tests/pt24_facility_connection_tests.gd")
const Compact=preload("res://tests/test_compact_clyde.gd")
const Metadata=preload("res://tests/grind_contact_metadata_tests.gd")
const Surfaces=preload("res://tests/surface_coverage_tests.gd")
const Career=preload("res://tests/career_route_tests.gd")
const Lines=preload("res://tests/line_design_tests.gd")
var passed:=0
var failed:=0
func _initialize():_run.call_deferred()
func _check(ok: bool,label: String):
	if ok:passed+=1
	else:failed+=1
	print("PASS: " if ok else "FAIL: ",label)
func _run():
	create_timer(900,true).timeout.connect(func():quit(3))
	Setup.register_actions()
	var game=Main.new()
	game.persistence_enabled=false
	root.add_child(game)
	game.start_mode(true)
	await Driver._frames(self,25)
	await Layout.run(self,game,_check)
	await Civic.run(self,game,_check)
	await Driver.run(self,game,_check)
	await Clyde.run(self,game,_check)
	await Park.run(self,game,_check)
	await Gallery.run(self,game,_check)
	await Gate.run(self,game,_check)
	await ParkTransit.run(self,game,_check)
	await ParkCombo.run(self,game,_check)
	await Market.run(self,game,_check)
	await CivicPark.run(self,game,_check)
	await Facility.run(self,game,_check)
	print("C04 COMBINED: ",passed," passed, ",failed," failed")
	await Compact.run(self,game.world,_check)
	Metadata.run_world(game.world,_check)
	await Surfaces.run(self,game.world,_check)
	print("AUDIT COMBINED: ",passed," passed, ",failed," failed")
	await Career.run(self,game,_check)
	await Lines.run(self,game,_check)
	print("C04 AUDIT CAREER COMBINED RESULT: ",passed," passed, ",failed," failed")
	game.free()
	quit(1 if failed>0 else 0)
