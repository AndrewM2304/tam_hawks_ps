+		and absf(visual.position.y-bowl.radius+.018)<.000001 \
+		and absf(Vector3(bowl.lip_frame(0).point).y-2.012)<.000001,
+		"PT24 current coping: actual60mm pipe section and12mm crown match the researched fixture")
